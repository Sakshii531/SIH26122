# ── Copy this file to .env and fill in real values ────────────────────────────
# cp backend/.env.example backend/.env
#
# IMPORTANT: Never commit .env to version control.
# .env is listed in .gitignore and should contain real secrets only locally.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="SIH26122 Backend"
APP_VERSION="0.1.0"
DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database & Supabase (Step 16 Readiness) ───────────────────────────────────
# DB_PROVIDER controls which repository backend is used:
#   in_memory  — no database required (current default, safe for local dev & CI)
#   supabase   — live Supabase PostgreSQL (Step 16 and beyond)
DB_PROVIDER=in_memory
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
