# ── Copy this file to .env and fill in real values ────────────────────────────
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="SIH26122 Backend"
APP_VERSION="0.1.0"
DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Database & Supabase (Step 16 Readiness) ───────────────────────────────────
# DB_PROVIDER controls which storage backend the app uses.
# "in_memory"  — default; no external DB needed (all tests use this)
# "supabase"   — enables Supabase-backed repositories (set credentials below)
DB_PROVIDER="in_memory"

# Supabase project URL — found in: Supabase dashboard → Settings → API → Project URL
# SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Anon/public key — safe for client-facing requests; respects Row-Level Security
# SUPABASE_KEY="your-anon-key-here"

# Service-role key — bypasses RLS; server-side admin use only; NEVER expose to frontend
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Direct Postgres connection URL (optional — for future SQLAlchemy/asyncpg usage)
# DATABASE_URL="postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres"

# ── Authentication ────────────────────────────────────────────────────────────
# Supabase access tokens are verified using the project's public JWKS endpoint.

# Enable/disable authentication (set to false in test environments to bypass auth checks)
AUTH_ENABLED=true

